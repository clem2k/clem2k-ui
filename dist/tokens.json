     },
     {
      "name": "h2",
      "fontSize": "20px",
      "lineHeight": "28px",
      "fontWeight": 600,
      "usage": "Sub-sections, panel titles."
     },
     {
      "name": "h3",
      "fontSize": "16px",
      "lineHeight": "24px",
      "fontWeight": 600,
      "usage": "Card titles, group labels inside panels."
     },
     {
      "name": "body",
      "fontSize": "16px",
      "lineHeight": "26px",
      "fontWeight": 400,
      "sample": "Readable first. The green is a signal, not a wallpaper.",
      "usage": "All running text. Keep lines at 72 characters or fewer."
     },
     {
      "name": "small",
      "fontSize": "13px",
      "lineHeight": "20px",
      "fontWeight": 400,
      "usage": "Metadata, captions, help text, table cells in dense views."
     },
     {
      "name": "code",
      "fontSize": "15px",
      "lineHeight": "24px",
      "fontWeight": 400,
