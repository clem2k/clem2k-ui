/* clem2k-ui Qt stylesheet (hc) — generated by scripts/build.py. Qt has no backdrop blur: glass becomes opaque bg-200. */
* { font-family: "JetBrains Mono", monospace; font-size: 15px; color: #f0f7f0; }
QWidget { background: #050705; selection-background-color: #123a0e; selection-color: #ffffff; }
QMainWindow, QDialog { background: #050705; }
QLabel { background: transparent; }
QLabel[role="muted"] { color: #c2d0c3; }
QLabel[role="h1"] { font-size: 28px; font-weight: 700; color: #ffffff; }
QLabel[role="h2"] { font-size: 20px; font-weight: 600; color: #ffffff; }
QToolBar, QMenuBar, QStatusBar, QDockWidget, QMenu, QToolTip, QFrame[glass="true"] { background: #0d110e; border: 1px solid rgba(207, 220, 207, 0.55); }
QToolBar { border-radius: 20px; padding: 4px; spacing: 4px; }
QMenu { border-radius: 12px; padding: 6px; }
QMenu::item { padding: 6px 12px; border-radius: 8px; }
QMenu::item:selected { background: #123a0e; color: #ffffff; }
QMenu::separator { height: 1px; background: rgba(207, 220, 207, 0.55); margin: 6px 4px; }
QToolTip { border-radius: 12px; padding: 4px 10px; color: #f0f7f0; }
QStatusBar { background: #000000; color: #c2d0c3; font-size: 12px; border-width: 1px 0 0 0; border-color: #7d907f; }
QPushButton { background: transparent; color: #ffffff; border: 1px solid #a3b5a5; border-radius: 2px; padding: 8px 16px; font-size: 12px; font-weight: 600; }
QPushButton:hover { background: #161c17; }
QPushButton:focus { border: 2px solid #4dff2b; }
QPushButton:disabled { color: #c2d0c3; border-color: #7d907f; }
QPushButton[variant="primary"] { background: #4dff2b; border-color: #4dff2b; color: #000000; }
QPushButton[variant="primary"]:hover { background: #c4ffb8; }
QPushButton[variant="danger"] { background: #ff6a45; border-color: #ff6a45; color: #000000; }
QPushButton[variant="ghost"] { border-color: transparent; color: #f0f7f0; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox { background: #000000; color: #ffffff; border: 1px solid #a3b5a5; border-radius: 2px; padding: 6px 10px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border: 2px solid #4dff2b; }
QLineEdit[error="true"] { border-color: #ff6a45; }
QComboBox QAbstractItemView { background: #0d110e; border: 1px solid rgba(207, 220, 207, 0.55); selection-background-color: #123a0e; }
QCheckBox, QRadioButton { background: transparent; spacing: 10px; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; border: 1px solid #a3b5a5; background: #000000; }
QCheckBox::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:checked { background: #4dff2b; border-color: #4dff2b; }
QRadioButton::indicator:checked { background: #4dff2b; border: 1px solid #4dff2b; }
QSlider::groove:horizontal { height: 4px; background: #a3b5a5; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #4dff2b; border-radius: 2px; }
QSlider::handle:horizontal { width: 16px; height: 16px; margin: -7px 0; border-radius: 9px; background: #ffffff; border: 3px solid #4dff2b; }
QProgressBar { background: #000000; border: 1px solid #a3b5a5; height: 10px; text-align: right; color: #4dff2b; }
QProgressBar::chunk { background: #4dff2b; }
QTabBar::tab { background: transparent; color: #c2d0c3; padding: 8px 0; margin-right: 24px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #ffffff; border-bottom-color: #4dff2b; }
QTabWidget::pane { border: 0; border-top: 1px solid #7d907f; }
QListView, QTreeView, QTableView { background: #050705; border: 0; alternate-background-color: #0d110e; outline: 0; }
QListView::item, QTreeView::item { padding: 6px 10px; border-radius: 12px; }
QListView::item:hover, QTreeView::item:hover { background: #161c17; }
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected { background: #123a0e; color: #ffffff; }
QHeaderView::section { background: #050705; color: #c2d0c3; border: 0; border-bottom: 1px solid #a3b5a5; padding: 8px 12px; font-size: 12px; font-weight: 600; }
QTableView { gridline-color: #7d907f; }
QScrollBar:vertical, QScrollBar:horizontal { background: transparent; width: 10px; height: 10px; }
QScrollBar::handle { background: #a3b5a5; border-radius: 5px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #c2d0c3; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
