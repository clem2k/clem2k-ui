/* clem2k-ui Qt stylesheet (light) — generated by scripts/build.py. Qt has no backdrop blur: glass becomes opaque bg-200. */
* { font-family: "JetBrains Mono", monospace; font-size: 15px; color: #1c241d; }
QWidget { background: #f5f8f4; selection-background-color: #d2f0c9; selection-color: #0b100c; }
QMainWindow, QDialog { background: #f5f8f4; }
QLabel { background: transparent; }
QLabel[role="muted"] { color: #4a5c4c; }
QLabel[role="h1"] { font-size: 28px; font-weight: 700; color: #0b100c; }
QLabel[role="h2"] { font-size: 20px; font-weight: 600; color: #0b100c; }
QToolBar, QMenuBar, QStatusBar, QDockWidget, QMenu, QToolTip, QFrame[glass="true"] { background: #ffffff; border: 1px solid rgba(28, 36, 29, 0.14); }
QToolBar { border-radius: 20px; padding: 4px; spacing: 4px; }
QMenu { border-radius: 12px; padding: 6px; }
QMenu::item { padding: 6px 12px; border-radius: 8px; }
QMenu::item:selected { background: #d2f0c9; color: #0b100c; }
QMenu::separator { height: 1px; background: rgba(28, 36, 29, 0.14); margin: 6px 4px; }
QToolTip { border-radius: 12px; padding: 4px 10px; color: #1c241d; }
QStatusBar { background: #eaefe9; color: #4a5c4c; font-size: 12px; border-width: 1px 0 0 0; border-color: #ccd6cb; }
QPushButton { background: transparent; color: #0b100c; border: 1px solid #6c7f6e; border-radius: 2px; padding: 8px 16px; font-size: 12px; font-weight: 600; }
QPushButton:hover { background: #e0e8df; }
QPushButton:focus { border: 2px solid #156b08; }
QPushButton:disabled { color: #4a5c4c; border-color: #ccd6cb; }
QPushButton[variant="primary"] { background: #156b08; border-color: #156b08; color: #ffffff; }
QPushButton[variant="primary"]:hover { background: #0f5a04; }
QPushButton[variant="danger"] { background: #c7380c; border-color: #c7380c; color: #ffffff; }
QPushButton[variant="ghost"] { border-color: transparent; color: #1c241d; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox { background: #eaefe9; color: #0b100c; border: 1px solid #6c7f6e; border-radius: 2px; padding: 6px 10px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border: 2px solid #156b08; }
QLineEdit[error="true"] { border-color: #c7380c; }
QComboBox QAbstractItemView { background: #ffffff; border: 1px solid rgba(28, 36, 29, 0.14); selection-background-color: #d2f0c9; }
QCheckBox, QRadioButton { background: transparent; spacing: 10px; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; border: 1px solid #6c7f6e; background: #eaefe9; }
QCheckBox::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:checked { background: #156b08; border-color: #156b08; }
QRadioButton::indicator:checked { background: #156b08; border: 1px solid #156b08; }
QSlider::groove:horizontal { height: 4px; background: #6c7f6e; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #156b08; border-radius: 2px; }
QSlider::handle:horizontal { width: 16px; height: 16px; margin: -7px 0; border-radius: 9px; background: #0b100c; border: 3px solid #156b08; }
QProgressBar { background: #eaefe9; border: 1px solid #6c7f6e; height: 10px; text-align: right; color: #156b08; }
QProgressBar::chunk { background: #156b08; }
QTabBar::tab { background: transparent; color: #4a5c4c; padding: 8px 0; margin-right: 24px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #0b100c; border-bottom-color: #156b08; }
QTabWidget::pane { border: 0; border-top: 1px solid #ccd6cb; }
QListView, QTreeView, QTableView { background: #f5f8f4; border: 0; alternate-background-color: #ffffff; outline: 0; }
QListView::item, QTreeView::item { padding: 6px 10px; border-radius: 12px; }
QListView::item:hover, QTreeView::item:hover { background: #e0e8df; }
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected { background: #d2f0c9; color: #0b100c; }
QHeaderView::section { background: #f5f8f4; color: #4a5c4c; border: 0; border-bottom: 1px solid #6c7f6e; padding: 8px 12px; font-size: 12px; font-weight: 600; }
QTableView { gridline-color: #ccd6cb; }
QScrollBar:vertical, QScrollBar:horizontal { background: transparent; width: 10px; height: 10px; }
QScrollBar::handle { background: #6c7f6e; border-radius: 5px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #4a5c4c; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
