/* clem2k-ui Qt stylesheet (dark) — generated by scripts/build.py. Qt has no backdrop blur: glass becomes opaque bg-200. */
* { font-family: "JetBrains Mono", monospace; font-size: 15px; color: #cfdccf; }
QWidget { background: #0e120f; selection-background-color: #173d12; selection-color: #eaf2ea; }
QMainWindow, QDialog { background: #0e120f; }
QLabel { background: transparent; }
QLabel[role="muted"] { color: #9cae9e; }
QLabel[role="h1"] { font-size: 28px; font-weight: 700; color: #eaf2ea; }
QLabel[role="h2"] { font-size: 20px; font-weight: 600; color: #eaf2ea; }
QToolBar, QMenuBar, QStatusBar, QDockWidget, QMenu, QToolTip, QFrame[glass="true"] { background: #151a16; border: 1px solid rgba(207, 220, 207, 0.16); }
QToolBar { border-radius: 20px; padding: 4px; spacing: 4px; }
QMenu { border-radius: 12px; padding: 6px; }
QMenu::item { padding: 6px 12px; border-radius: 8px; }
QMenu::item:selected { background: #173d12; color: #eaf2ea; }
QMenu::separator { height: 1px; background: rgba(207, 220, 207, 0.16); margin: 6px 4px; }
QToolTip { border-radius: 12px; padding: 4px 10px; color: #cfdccf; }
QStatusBar { background: #0a0d0b; color: #9cae9e; font-size: 12px; border-width: 1px 0 0 0; border-color: #283129; }
QPushButton { background: transparent; color: #eaf2ea; border: 1px solid #5f7261; border-radius: 2px; padding: 8px 16px; font-size: 12px; font-weight: 600; }
QPushButton:hover { background: #1d241e; }
QPushButton:focus { border: 2px solid #3be81a; }
QPushButton:disabled { color: #9cae9e; border-color: #283129; }
QPushButton[variant="primary"] { background: #3be81a; border-color: #3be81a; color: #0a0d0b; }
QPushButton[variant="primary"]:hover { background: #a8f59a; }
QPushButton[variant="danger"] { background: #f84818; border-color: #f84818; color: #0a0d0b; }
QPushButton[variant="ghost"] { border-color: transparent; color: #cfdccf; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox { background: #0a0d0b; color: #eaf2ea; border: 1px solid #5f7261; border-radius: 2px; padding: 6px 10px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus { border: 2px solid #3be81a; }
QLineEdit[error="true"] { border-color: #f84818; }
QComboBox QAbstractItemView { background: #151a16; border: 1px solid rgba(207, 220, 207, 0.16); selection-background-color: #173d12; }
QCheckBox, QRadioButton { background: transparent; spacing: 10px; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; border: 1px solid #5f7261; background: #0a0d0b; }
QCheckBox::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:checked { background: #3be81a; border-color: #3be81a; }
QRadioButton::indicator:checked { background: #3be81a; border: 1px solid #3be81a; }
QSlider::groove:horizontal { height: 4px; background: #5f7261; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #3be81a; border-radius: 2px; }
QSlider::handle:horizontal { width: 16px; height: 16px; margin: -7px 0; border-radius: 9px; background: #eaf2ea; border: 3px solid #3be81a; }
QProgressBar { background: #0a0d0b; border: 1px solid #5f7261; height: 10px; text-align: right; color: #3be81a; }
QProgressBar::chunk { background: #3be81a; }
QTabBar::tab { background: transparent; color: #9cae9e; padding: 8px 0; margin-right: 24px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #eaf2ea; border-bottom-color: #3be81a; }
QTabWidget::pane { border: 0; border-top: 1px solid #283129; }
QListView, QTreeView, QTableView { background: #0e120f; border: 0; alternate-background-color: #151a16; outline: 0; }
QListView::item, QTreeView::item { padding: 6px 10px; border-radius: 12px; }
QListView::item:hover, QTreeView::item:hover { background: #1d241e; }
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected { background: #173d12; color: #eaf2ea; }
QHeaderView::section { background: #0e120f; color: #9cae9e; border: 0; border-bottom: 1px solid #5f7261; padding: 8px 12px; font-size: 12px; font-weight: 600; }
QTableView { gridline-color: #283129; }
QScrollBar:vertical, QScrollBar:horizontal { background: transparent; width: 10px; height: 10px; }
QScrollBar::handle { background: #5f7261; border-radius: 5px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #9cae9e; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
