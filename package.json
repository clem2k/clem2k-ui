{
  "name": "clem2k-ui",
  "version": "0.2.0",
  "description": "clem2k design system: tokens, CSS, React 18 components, Tailwind preset, Qt theme and pixel icons.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/clem2k.mjs",
  "module": "./dist/clem2k.mjs",
  "types": "./dist/clem2k.d.ts",
  "style": "./dist/clem2k.css",
  "exports": {
    ".": { "types": "./dist/clem2k.d.ts", "import": "./dist/clem2k.mjs" },
    "./clem2k.css": "./dist/clem2k.css",
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/clem2k.components.css",
    "./tokens.json": "./dist/tokens.json",
    "./tailwind": "./dist/tailwind.preset.cjs",
    "./umd": "./dist/clem2k.js",
    "./icons/*": "./dist/icons/*",
    "./icons.svg": "./dist/icons.svg",
    "./logo/*": "./assets/logo/*"
  },
  "files": ["dist", "assets"],
  "peerDependencies": { "react": "^18.2.0", "react-dom": "^18.2.0" },
  "peerDependenciesMeta": { "react": { "optional": true }, "react-dom": { "optional": true } },
  "scripts": { "build": "python3 scripts/build.py" },
  "repository": { "type": "git", "url": "https://github.com/clem2k/clem2k-ui.git" }
}
